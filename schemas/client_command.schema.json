        "text_file",
        "document",
        "unknown"
      ]
    },
    "AttachmentRef": {
      "description": "A reference to a processed, stored attachment (spec §39). Carries only metadata; the bytes are addressed by `sha256` in the media store.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "mime_type",
        "name",
