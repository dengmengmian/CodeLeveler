    "UiMemoryKind": {
      "description": "What a durable memory IS. Strongly typed so no client invents its own strings for a field the domain has to interpret.",
      "oneOf": [
        {
          "description": "Injected into every turn while active.",
          "type": "string",
          "enum": [
