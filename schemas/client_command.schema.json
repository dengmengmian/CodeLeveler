    "PermissionProfile": {
      "type": "string",
      "enum": [
        "request_approval",
        "assisted",
        "full_access"
      ]
    },
    "RestartReason": {
      "description": "Why a runtime is being asked to retire.\n\nTyped rather than a string because the updater will reuse this exact lifecycle: install an artifact, ask the running runtime to retire, verify the replacement's identity. Only the reason differs.",
      "oneOf": [
        {
          "description": "The connecting client is a different build than this runtime.",
          "type": "string",
          "enum": [
            "build_mismatch"
          ]
        },
        {
          "description": "The connecting client sees a different effective configuration source generation than the running daemon loaded at boot.",
          "type": "string",
          "enum": [
            "config_changed"
          ]
        },
        {
          "description": "A newer artifact is installed and waiting to take over. Reserved for the updater; nothing sends it yet.",
          "type": "string",
          "enum": [
            "update_ready"
          ]
        }
      ]
    },
    "SessionId": {
      "description": "Identifies a single agent session (one user goal end to end).",
      "type": "string"
    },
    "ToolCallId": {
      "description": "Identifies a tool call. Must be stable across streaming reassembly.",
      "type": "string"
    },
