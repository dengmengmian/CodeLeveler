{
  "name": "leveler-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/gen-command-policy.mjs --check && node scripts/check.mjs",
    "gen:protocol": "node scripts/gen-command-policy.mjs",
    "check:protocol": "node scripts/gen-command-policy.mjs --check",
    "test": "node --test test/*.test.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "postinstall": "install-electron",
    "test:interactions": "node scripts/interactions.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "test:product": "node scripts/product.mjs",
    "test:model-picker": "node scripts/model-picker.mjs",
    "test:smoke": "node scripts/product.mjs && node scripts/session-actions.mjs && node scripts/composer.mjs && node scripts/schedules.mjs && node scripts/schedule-tool-card.mjs && node scripts/definition-trust.mjs && node scripts/secret-custody.mjs && node scripts/modes.mjs",
    "test:modes": "node scripts/modes.mjs",
    "test:mcp": "node scripts/mcp-desktop.mjs",
    "test:mcp:dogfood": "node scripts/mcp-dogfood.mjs",
    "test:review": "node scripts/review-desktop.mjs",
    "test:review:dogfood": "node scripts/review-dogfood.mjs",
    "test:skills": "node scripts/skills-desktop.mjs && node scripts/skills-modes.mjs",
    "test:skills:dogfood": "node scripts/skills-dogfood.mjs",
    "test:r2c": "node scripts/r2c-tool-output.mjs && node scripts/r2c-goal-boundary.mjs",
    "test:long-session": "node scripts/long-session.mjs",
    "test:session-actions": "node scripts/session-actions.mjs",
    "test:conversation": "node scripts/conversation.mjs",
    "test:composer": "node scripts/composer.mjs",
    "test:composer-narrow": "node scripts/composer-narrow.mjs",
    "test:terminal-permissions": "node scripts/terminal-permissions.mjs",
    "test:terminal-permissions:finder": "node scripts/terminal-permissions-finder.mjs",
    "test:memory": "node scripts/r6-memory.mjs",
    "test:memory:dogfood": "node scripts/r6-memory-dogfood.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "eslint": "^10.11.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "marked": "18.0.14"
  }
}
