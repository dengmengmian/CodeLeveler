diff --git a/internal/report/names.go b/internal/report/names.go
new file mode 100644
index 0000000..dc1ebd6
--- /dev/null
+++ b/internal/report/names.go
@@ -0,0 +1,24 @@
+package report
+
+import (
+	"sort"
+
+	"navsvc/pkg/api"
+)
+
+// Names returns the distinct record names across the batches, sorted. Invalid
+// records still count: the caller wants every name that appeared.
+func Names(batches []api.Batch) []string {
+	seen := map[string]struct{}{}
+	for _, batch := range batches {
+		for _, record := range batch.Records {
+			seen[record.Name] = struct{}{}
+		}
+	}
+	names := make([]string, 0, len(seen))
+	for name := range seen {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
