@@ -0,0 +1,20 @@
+package report
+
+import (
+	"testing"
+
+	"navsvc/pkg/api"
+)
+
+// Covers the --names-only mode's counting rule: sorted, distinct, and invalid
+// records still contribute their name.
+func TestNamesOnlyIncludesInvalidRecords(t *testing.T) {
+	names := Names([]api.Batch{{Records: []api.Record{
+		{Name: "b", Value: 1, Valid: true},
+		{Name: "a", Value: 2, Valid: true},
+		{Name: "b", Valid: false},
+	}}})
+	if len(names) != 2 || names[0] != "a" || names[1] != "b" {
+		t.Fatalf("want [a b], got %v", names)
+	}
+}
