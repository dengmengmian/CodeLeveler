+// rowName is the name a record is reported under. Records carrying an `env`
+// label are grouped per environment so operators running one exporter per
+// host can tell hosts apart; everything else keeps its plain name.
+func rowName(record api.Record) string {
+	if env, ok := record.Labels["env"]; ok {
+		return record.Name + "{env=" + env + "}"
+	}
+	return record.Name
+}
