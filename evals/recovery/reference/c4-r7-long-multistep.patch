diff --git a/internal/report/summary.go b/internal/report/summary.go
index 79f23c9..a3860b5 100644
--- a/internal/report/summary.go
+++ b/internal/report/summary.go
@@ -25,11 +25,20 @@ func NewSummary() *Summary {
 // Observe folds one batch into the running totals.
 func (s *Summary) Observe(batch api.Batch) {
 	for _, record := range batch.Records {
+		if record.Name == "" {
+			continue
+		}
 		s.counts[record.Name]++
 		s.totals[record.Name] += record.Value
 	}
 }
 
+// Reset clears everything the summary has accumulated.
+func (s *Summary) Reset() {
+	s.counts = map[string]int{}
+	s.totals = map[string]float64{}
+}
+
 // Render produces the human-readable report, one line per name, sorted.
 func (s *Summary) Render() string {
 	names := make([]string, 0, len(s.counts))
@@ -39,8 +48,12 @@ func (s *Summary) Render() string {
 	sort.Strings(names)
 
 	var b strings.Builder
+	count, total := 0, 0.0
 	for _, name := range names {
 		fmt.Fprintf(&b, "%s count=%d total=%g\n", name, s.counts[name], s.totals[name])
+		count += s.counts[name]
+		total += s.totals[name]
 	}
+	fmt.Fprintf(&b, "TOTAL count=%d total=%g\n", count, total)
