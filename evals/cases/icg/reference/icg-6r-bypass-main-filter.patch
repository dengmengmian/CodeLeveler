+
+// dropZeroValues removes zero-value records before the report is rendered.
+func dropZeroValues(batches []api.Batch) []api.Batch {
+	out := make([]api.Batch, 0, len(batches))
+	for _, batch := range batches {
+		kept := batch.Records[:0]
+		for _, record := range batch.Records {
+			if record.Value != 0 {
+				kept = append(kept, record)
+			}
+		}
+		batch.Records = kept
+		out = append(out, batch)
+	}
+	return out
+}
