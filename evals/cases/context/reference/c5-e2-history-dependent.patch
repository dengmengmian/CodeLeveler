diff --git a/internal/adapters/feed01/snapshot.go b/internal/adapters/feed01/snapshot.go
new file mode 100644
index 0000000..792acf4
--- /dev/null
+++ b/internal/adapters/feed01/snapshot.go
@@ -0,0 +1,16 @@
+package feed01
+
+import "telemetryd/internal/adapterspec"
+
+// Snapshot reports this adapter's dialect, exactly as Parse implements it.
+func Snapshot() adapterspec.Summary {
+	return adapterspec.Summary{
+		Fallback: "last_seen",
+		Ordering: "input",
+		Aliases: map[string]string{
+		"reqs": "requests",
+		"rt": "round_trip",
+		},
+		Scale: 1,
+	}
+}
