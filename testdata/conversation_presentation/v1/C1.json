{
  "id": "C1",
  "title": "a confirmed edit is displayed in full, directly",
  "invariant": "the runtime's confirmed applied_diff is the canonical Diff: every file, hunk and changed line is on screen with no click, no collapse, no diffstat-only summary and no row cap",
  "paths": {
    "live": [
      { "event": { "type": "user_message_added", "message": { "id": "u1", "role": "user", "text": "改掉旧的推荐模型" } } },
      { "event": { "type": "assistant_message_started", "message_id": "m1" } },
      { "event": { "type": "assistant_text_delta", "message_id": "m1", "delta": "先改 models.rs。" } },
      { "event": { "type": "assistant_message_completed", "message_id": "m1" } },
      { "event": { "type": "tool_call_started", "id": "t1", "name": "apply_patch", "arguments": "{\"patch\":\"*** Begin Patch\\n*** Update File: src/models.rs\\n@@\\n-const RECOMMENDED: &[&str] = [\\\"gpt-5.6\\\"];\\n+const RECOMMENDED: &[&str] = [\\\"gpt-6\\\"];\\n*** End Patch\"}", "parallel": false, "model_step": 1 } },
      { "event": { "type": "tool_call_completed", "id": "t1", "ok": true, "duration_ms": 12, "preview": "applied 1 file", "applied_diff": "--- a/src/models.rs\n+++ b/src/models.rs\n@@ -1,1 +1,1 @@\n-const RECOMMENDED: &[&str] = [\"gpt-5.6\"];\n+const RECOMMENDED: &[&str] = [\"gpt-6\"];\n" } },
      { "event": { "type": "assistant_message_started", "message_id": "m2" } },
      { "event": { "type": "assistant_text_delta", "message_id": "m2", "delta": "改好了。" } },
      { "event": { "type": "assistant_message_completed", "message_id": "m2" } },
      { "event": { "type": "turn_answered" } }
    ]
  },
  "expect": {
    "items": [
      { "kind": "user", "text": "改掉旧的推荐模型" },
      { "kind": "assistant_text", "text": "先改 models.rs。" },
      { "kind": "edit_diff", "paths": ["src/models.rs"], "added": 1, "removed": 1, "rendered_in_full": true, "needs_click": false },
      { "kind": "final_answer", "text": "改好了。" },
      { "kind": "turn_end", "status": "answered" }
    ]
  }
}
