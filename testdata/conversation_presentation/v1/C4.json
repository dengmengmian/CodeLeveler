{
  "id": "C4",
  "title": "a failed run shows its failure without expanding anything",
  "invariant": "a failed Run is collapsed by default AND its failure is readable on the collapsed row: status, exit code and the command's own failure line, never a runtime note",
  "paths": {
    "live": [
      {
        "event": {
          "type": "user_message_added",
          "message": {
            "id": "u1",
            "role": "user",
            "text": "跑一下映射测试"
          }
        }
      },
      {
        "event": {
          "type": "tool_call_started",
          "id": "t1",
          "name": "run_command",
          "arguments": "{\"program\":\"cargo\",\"args\":[\"test\",\"mapping\"]}",
          "parallel": false,
          "model_step": 1
        }
      },
      {
        "event": {
          "type": "tool_call_completed",
          "id": "t1",
          "ok": false,
          "exit_code": 101,
          "duration_ms": 900,
          "preview": "exit: 101\nrunning 2 tests\ntest mapping::recommended ... FAILED\nerror: test failed\n"
        }
      },
      {
        "event": {
          "type": "turn_failed",
          "error": "工具执行失败"
        }
      }
    ]
  },
  "expect": {
    "items": [
      {
        "kind": "user",
        "text": "跑一下映射测试"
      },
      {
        "kind": "run_receipt",
        "folded": true,
        "status": "failed",
        "failure_visible": true,
        "exit_code": 101,
        "failure_line": "test mapping::recommended ... FAILED"
      },
      {
        "kind": "turn_end",
        "status": "failed"
      }
    ]
  }
}
