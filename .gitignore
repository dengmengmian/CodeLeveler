/target
/target-dev
**/*.rs.bk
Cargo.lock.orig

# Local runtime state
*.db
*.db-wal
*.db-shm
.leveler/state/
.leveler/sessions.db*
.leveler/permissions.yaml
.leveler/media/
.leveler/drafts/
.local-leveler/

# Local agent/orchestration state
.claude/
.codex/
.omc/
CLAUDE.md

# Generated evaluation output
evals/baselines/*.json
evals/baselines/*.jsonl
evals/runs/*/
evals/**/__pycache__/
evals/**/*.pyc
evals/reports/*.json
evals/reports/*.jsonl
evals/reports/*.md
evals/reports/*.csv
evals/reports/adoption/
evals/reports/capability/
evals/reports/safety/
evals/reports/multi_agent/
!evals/reports/README.md
!evals/reports/EXAMPLE.md
!evals/runs/README.md
evals/suites/adoption/reports/*.json
evals/suites/adoption/reports/*.csv
evals/suites/adoption/reports/REPORT.md
evals/suites/adoption/reports/batch.json
# Version-trend history (run baselines) + generated regression report
evals/history/*.json
evals/history/*.jsonl
evals/results/*.json
evals/REGRESSION_REPORT.md

# Env / secrets — never commit
.env
.env.*
*.pem
*.key

# Editor
.idea/
.vscode/
.DS_Store

# Packaging output
dist/

# Local sandbox / tool-cache leftovers from execution tests
crates/leveler-execution/leveler-ac-*/
crates/leveler-execution/leveler-tool-cache/

# Conversation exports written by /export (default cwd)
leveler-chat-*.md

# Local per-session test scratch dir
# Ignore the CONTENTS, not the directory: git cannot re-include a file from
# inside a wholesale-excluded directory, and the matrix harness has to be
# reproducible from a fresh clone.
evals/fixtures/*
!evals/fixtures/matrix/
evals/fixtures/matrix/*
# The harness itself: drivers, the relative-path matrix, the fixture
# generator. Everything they produce — generated projects, cloned repos, run
# artefacts — stays ignored.
!evals/fixtures/matrix/tui_drive.py
!evals/fixtures/matrix/tui_stress.py
!evals/fixtures/matrix/tui_forty.py
!evals/fixtures/matrix/matrix.json
!evals/fixtures/matrix/setup.sh
!evals/fixtures/matrix/README.md
# The acceptance layer on top of those drivers: per-run isolation and sampling,
# the rounds, the attribution, the evidence tree and the release gates. These
# were nearly lost — the wholesale exclusion above swallowed them silently, and
# an unfetchable harness is the failure this file's own comment warns about.
!evals/fixtures/matrix/pty_acceptance.py
!evals/fixtures/matrix/pty_rounds.py
!evals/fixtures/matrix/pty_metrics.py
!evals/fixtures/matrix/pty_assemble.py
!evals/fixtures/matrix/pty_gate.py
# Per-obligation navigation oracles: tracked source, not generated output.
!evals/fixtures/navigation-obligations/

# Screenshot runs (scripts/screenshots.sh writes wherever it is told; this is
# the default place I point it at when looking at the app).
.shots*/
evals/comparative/results/
