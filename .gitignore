# Build
/target/
**/*.rs.bk

# Shared Cargo target for git worktrees (see scripts/shared-target.sh)
/.codeleveler-target/

# Local runtime state. `.leveler/config.yaml` is tracked: it is this
# repository's agent verification contract.
*.db
*.db-wal
*.db-shm
.leveler/state/
.leveler/sessions.db*
.leveler/permissions.yaml
.leveler/hooks.yaml
.leveler/media/
.leveler/drafts/
.local-leveler/

# Local developer entry config (may name a machine-specific dogfood lab).
.dev/

# Local editor / agent scratch
.omc/
.pi/
.claude/
.idea/
.vscode/
.DS_Store

# Secrets
.env
.env.*
*.pem
*.key

# Packaging output
dist/

# Execution-test leftovers
crates/leveler-execution/leveler-ac-*/
crates/leveler-execution/leveler-tool-cache/

# /export conversation dumps
leveler-chat-*.md

# Local test artifacts (screenshots, logs, acceptance reports)
/test-output/

# Legacy screenshot scratch
.shots*/

# Local internal documentation, not part of the public source tree.
/docs/ARCHITECTURE.md
/docs/ARCHITECTURE.zh-CN.md
/assets/brand/README.md
/crates/leveler-storage/migrations/README.md
/crates/leveler-web/README.md
/testdata/context_statistics/v1/README.md
/testdata/conversation_presentation/v1/README.md
/apps/leveler-mobile/ios/Runner/Assets.xcassets/LaunchImage.imageset/README.md
