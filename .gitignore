/target
**/*.rs.bk
Cargo.lock.orig

# Local runtime state
*.db
*.db-wal
*.db-shm
.leveler/state/
.leveler/sessions.db*
.leveler/permissions.yaml
.leveler/media/
.leveler/drafts/
.local-leveler/

# Local agent/orchestration state
.claude/
.codex/
.omc/
CLAUDE.md

# Generated evaluation output
evals/baselines/*.json
evals/baselines/*.jsonl
eval/runs/*/
eval/**/__pycache__/
eval/**/*.pyc
eval/reports/*.json
eval/reports/*.jsonl
eval/reports/*.md
eval/reports/*.csv
eval/reports/adoption/
eval/reports/capability/
eval/reports/safety/
!eval/reports/README.md
!eval/reports/EXAMPLE.md
!eval/runs/README.md
eval/micro/adoption/reports/*.json
eval/micro/adoption/reports/*.csv
eval/micro/adoption/reports/REPORT.md
eval/micro/adoption/reports/batch.json
# Version-trend history (run baselines) + generated regression report
evals/history/*.json
evals/history/*.jsonl
evals/results/*.json
evals/REGRESSION_REPORT.md

# Env / secrets — never commit
.env
.env.*
*.pem
*.key

# Editor
.idea/
.vscode/
.DS_Store

# Packaging output
dist/

# Local sandbox / tool-cache leftovers from execution tests
crates/leveler-execution/leveler-ac-*/
crates/leveler-execution/leveler-tool-cache/

# Conversation exports written by /export (default cwd)
leveler-chat-*.md

# Local per-session test scratch dir
# Ignore the CONTENTS, not the directory: git cannot re-include a file from
# inside a wholesale-excluded directory, and the matrix harness has to be
# reproducible from a fresh clone.
fixtures/*
!fixtures/matrix/
fixtures/matrix/*
# The harness itself: drivers, the relative-path matrix, the fixture
# generator. Everything they produce — generated projects, cloned repos, run
# artefacts — stays ignored.
!fixtures/matrix/tui_drive.py
!fixtures/matrix/tui_stress.py
!fixtures/matrix/tui_forty.py
!fixtures/matrix/matrix.json
!fixtures/matrix/setup.sh
!fixtures/matrix/README.md

# Screenshot runs (scripts/screenshots.sh writes wherever it is told; this is
# the default place I point it at when looking at the app).
.shots*/
