file = crates/leveler-memory/src/audit.rs
symbol = is_canonical_key
construct = text-predicate
hits = 1
reason = normalized key protocol: durable keys are `k-` plus slug or hash; this is spelling, not meaning
owner = memory-lifecycle
test = stale_residue_is_reported_without_being_repaired
