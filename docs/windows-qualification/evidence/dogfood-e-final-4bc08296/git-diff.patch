+/// 按行切分 CSV：兼容 CRLF、UTF-8 BOM 与末尾/中间的空行。
+fn data_lines(csv: &str) -> impl Iterator<Item = &str> + '_ {
+    csv.split('\n')
+        .map(|line| line.strip_suffix('\r').unwrap_or(line))
+        .map(|line| line.strip_prefix('\u{feff}').unwrap_or(line))
+        .filter(|line| !line.trim().is_empty())
+}
+
+/// 以逗号切分一行并去掉字段两侧空白；数据不含带引号的逗号字段。
+fn split_row(line: &str) -> Vec<&str> {
+    line.split(',').map(str::trim).collect()
+}
+
+fn expect_header(line: &str, expected: &[&str], label: &str) -> Result<(), String> {
+    let fields = split_row(line);
+    let matches = fields.len() == expected.len()
+        && fields.iter().zip(expected).all(|(actual, want)| actual == want);
+    if matches {
+        Ok(())
+    } else {
+        Err(format!(
+            "{label}表头应为 {}，实际为 {line}",
+            expected.join(",")
+        ))
+    }
+}
+
+/// 解析库存与流水并计算期末库存。
+///
+/// 规则见 README：同一 SKU 的多条流水累加；流水引用未知 SKU 或期末库存为负
+/// 均返回包含该 SKU 的错误；结果按 SKU 升序排列。
+pub fn reconcile(stock_csv: &str, movements_csv: &str) -> Result<Vec<StockRow>, String> {
+    let stock_lines: Vec<&str> = data_lines(stock_csv).collect();
+    let movement_lines: Vec<&str> = data_lines(movements_csv).collect();
+
+    let mut rows: Vec<StockRow> = Vec::new();
+    let mut position: HashMap<String, usize> = HashMap::new();
+
+    if let Some((header, body)) = stock_lines.split_first() {
+        expect_header(header, &["sku", "name", "quantity"], "库存")?;
+        for line in body {
+            let fields = split_row(line);
+            if fields.len() != 3 {
+                return Err(format!("库存表格式错误，应为 sku,name,quantity：{line}"));
+            }
+            let sku = fields[0];
+            if sku.is_empty() {
+                return Err(format!("库存表存在空 SKU：{line}"));
+            }
+            let quantity: i64 = fields[2]
+                .parse()
+                .map_err(|_| format!("库存表数量不是整数：{line}"))?;
+            if position.contains_key(sku) {
+                return Err(format!("库存表 SKU 重复：{sku}"));
+            }
+            position.insert(sku.to_string(), rows.len());
+            rows.push(StockRow {
+                sku: sku.to_string(),
+                name: fields[1].to_string(),
+                quantity,
+            });
+        }
+    }
+
+    if let Some((header, body)) = movement_lines.split_first() {
+        expect_header(header, &["sku", "delta"], "流水")?;
+        for line in body {
+            let fields = split_row(line);
+            if fields.len() != 2 {
+                return Err(format!("流水表格式错误，应为 sku,delta：{line}"));
+            }
+            let sku = fields[0];
+            let delta: i64 = fields[1]
+                .parse()
+                .map_err(|_| format!("流水表数量不是整数：{line}"))?;
+            match position.get(sku) {
+                Some(&index) => rows[index].quantity += delta,
+                None => return Err(format!("流水引用了库存表中不存在的 SKU：{sku}")),
+            }
+        }
+    }
+
+    for row in &rows {
+        if row.quantity < 0 {
+            return Err(format!(
+                "SKU {} 出现负库存，期末库存为 {}",
+                row.sku, row.quantity
+            ));
+        }
+    }
+
+    rows.sort_by(|a, b| a.sku.cmp(&b.sku));
+    Ok(rows)
 }
 
