# CodeLeveler global config — created by `leveler login`.
# Reference: https://github.com/dengmengmian/CodeLeveler#configuration
# 默认使用的模型，格式为 provider/model。
# Default model, in provider/model form.
default_model = "deepseek/deepseek-flash"

[update]
# 启动时自动检查并安装最新稳定版；设为 false 可关闭。
# Check for and install the latest stable release at startup; set false to disable.
auto_update = true
# 成功检查更新后的最短检查间隔（小时）；0 表示每次启动都检查。
# Minimum hours between successful update checks; 0 checks on every start.
check_interval_hours = 0

[providers.deepseek]
# 供应商 API 地址。
# Provider API base URL.
base_url = "https://api.deepseek.com"
# 保存 API Key 的环境变量名。
# Environment variable containing the API key.
api_key_env = "DEEPSEEK_API_KEY"

[models.deepseek-flash]
# 此模型所属的供应商。
# Provider used by this model.
provider = "deepseek"
# 模型的最大上下文长度（token）。
# Maximum model context window in tokens.
context_window = 1048576
# 发送给供应商的真实模型 ID。
# Model ID sent to the provider.
model_id = "deepseek-flash"
# 此模型使用的接口协议。
# API protocol used by this model.
protocol = "openai_chat"
# 是否使用流式响应。
# Whether streaming responses are enabled.
streaming = true
# 模型是否支持工具调用。
# Whether the model supports tool calls.
tool_calling = true
# 模型是否支持并行工具调用。
# Whether the model supports parallel tool calls.
parallel_tool_calls = true
# 模型是否支持结构化输出。
# Whether the model supports structured output.
structured_output = true
# 模型是否支持图片输入。
# Whether the model accepts image input.
vision = true
# 模型是否支持推理模式。
# Whether the model supports reasoning mode.
reasoning = true
# 供应商使用的推理参数格式。
# Provider-specific reasoning parameter style.
reasoning_style = "thinking_flag"
# 模型支持的推理强度。
# Reasoning effort levels supported by the model.
supported_efforts = ["low", "high", "max"]
# 默认推理强度。
# Default reasoning effort.
reasoning_effort = "max"
# 触发压缩前可可靠使用的上下文长度。
# Reliable context size before compaction.
reliable_context = 786432
# 单次响应允许的最大输出 token 数。
# Maximum output tokens per response.
max_output_tokens = 393216
# 发送给模型的工具定义最大字节数。
# Maximum tool-schema bytes sent to the model.
max_tool_schema_bytes = 32768
# 单轮允许的并行工具调用上限；0 表示不额外限制。
# Parallel tool-call limit per turn; 0 means no extra limit.
max_parallel_tool_calls = 0
# 供应商是否接受 temperature 参数。
# Whether the provider accepts the temperature parameter.
supports_temperature = true
# 推理模式是否支持强制选择工具。
# Whether reasoning mode supports forced tool choice.
thinking_supports_forced_tool_choice = false
# non-interactive: template printed, nothing written.
# save it to: C:\qlab\home-fresh\config.toml
