+//! 库存对账 CLI：读取库存表与流水表，打印每个 SKU 的期末库存。
+
+use std::process::exit;
+
+use inventory_reconcile::reconcile;
+
 fn main() {
-    eprintln!("inventory-reconcile: 尚未实现，请完成 reconcile 与 CLI");
-    std::process::exit(2);
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() != 3 {
+        eprintln!("用法: {} <stock.csv> <movements.csv>", args[0]);
+        exit(2);
+    }
+
+    match run(&args[1], &args[2]) {
+        Ok(()) => {}
+        Err(err) => {
+            eprintln!("错误: {err}");
+            exit(1);
+        }
+    }
+}
+
+fn run(stock_path: &str, movements_path: &str) -> Result<(), String> {
+    let stock_csv =
+        std::fs::read_to_string(stock_path).map_err(|e| format!("无法读取库存表 {stock_path}: {e}"))?;
+    let movements_csv = std::fs::read_to_string(movements_path)
+        .map_err(|e| format!("无法读取流水表 {movements_path}: {e}"))?;
+
+    for row in reconcile(&stock_csv, &movements_csv)? {
+        println!("{},{},{}", row.sku, row.name, row.quantity);
+    }
+    Ok(())
 }
