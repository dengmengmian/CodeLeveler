+/// 解析库存与流水并计算期末库存。
+///
+/// 两个输入都是 UTF-8 CSV 文本：首行为表头，允许 CRLF 行尾与末尾空行。
+/// 同一个 SKU 的多条流水累加；流水引用未知 SKU 或期末库存为负都返回错误，
+/// 错误信息包含对应 SKU。结果按 SKU 升序。
+pub fn reconcile(stock_csv: &str, movements_csv: &str) -> Result<Vec<StockRow>, String> {
+    let mut rows: Vec<StockRow> = Vec::new();
+    let mut index: HashMap<String, usize> = HashMap::new();
+
+    for (lineno, line) in body_lines(stock_csv) {
+        let (sku, rest) = line
+            .split_once(',')
+            .ok_or_else(|| format!("库存表第 {lineno} 行格式错误，应为 sku,name,quantity: {line}"))?;
+        let (name, quantity) = rest.rsplit_once(',').ok_or_else(|| {
+            format!("库存表第 {lineno} 行格式错误，应为 sku,name,quantity: {line}")
+        })?;
+        let sku = sku.trim();
+        let name = name.trim();
+        let quantity_text = quantity.trim();
+        if sku.is_empty() {
+            return Err(format!("库存表第 {lineno} 行缺少 SKU"));
+        }
+        let quantity: i64 = quantity_text.parse().map_err(|_| {
+            format!("库存表第 {lineno} 行 SKU {sku} 的数量不是整数: {quantity_text}")
+        })?;
+        if index.contains_key(sku) {
+            return Err(format!("库存表第 {lineno} 行 SKU {sku} 重复出现"));
+        }
+        index.insert(sku.to_string(), rows.len());
+        rows.push(StockRow {
+            sku: sku.to_string(),
+            name: name.to_string(),
+            quantity,
+        });
+    }
+
+    for (lineno, line) in body_lines(movements_csv) {
+        let (sku, delta) = line
+            .split_once(',')
+            .ok_or_else(|| format!("流水表第 {lineno} 行格式错误，应为 sku,delta: {line}"))?;
+        let sku = sku.trim();
+        let delta_text = delta.trim();
+        let delta: i64 = delta_text.parse().map_err(|_| {
+            format!("流水表第 {lineno} 行 SKU {sku} 的变动量不是整数: {delta_text}")
+        })?;
+        let position = index
+            .get(sku)
+            .copied()
+            .ok_or_else(|| format!("流水表第 {lineno} 行引用了库存中不存在的 SKU: {sku}"))?;
+        rows[position].quantity += delta;
+    }
+
+    for row in &rows {
+        if row.quantity < 0 {
+            return Err(format!(
+                "SKU {} 出现负库存: 期末库存 {}",
+                row.sku, row.quantity
+            ));
+        }
+    }
+
+    rows.sort_by(|a, b| a.sku.cmp(&b.sku));
+    Ok(rows)
+}
+
+/// 迭代 CSV 表体：跳过表头行、空行（含末尾空行），行号从 1 起算并包含表头。
+///
+/// `str::lines` 已经去掉了 CRLF 行尾的 `\r`，这里再兜底一次。
+fn body_lines(csv: &str) -> impl Iterator<Item = (usize, &str)> {
+    let text = csv.strip_prefix('\u{feff}').unwrap_or(csv);
+    text.lines()
+        .enumerate()
+        .skip(1)
+        .map(|(offset, line)| (offset + 1, line.trim_end_matches('\r')))
+        .filter(|(_, line)| !line.trim().is_empty())
 }
 
