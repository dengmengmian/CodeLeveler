-/// 汇总订单总额。当前实现返回 0，业务逻辑尚未实现。
+/// 汇总订单总额。
+///
+/// 输入是 UTF-8 中文表头的 CSV：首行为表头，金额是每行最后一个字段。
+/// 允许 CRLF 行尾与末尾空行，完全空行会被忽略。
+/// 金额不是整数时直接 panic，避免静默少算。
 pub fn total_amount(csv: &str) -> u64 {
-    let _ = csv;
-    0
+    csv.lines()
+        .skip(1) // 跳过中文表头
+        .map(str::trim)
+        .filter(|line| !line.is_empty())
+        .map(|line| {
+            // 取最后一个字段作为金额，逗号后可能带空格。
+            let amount = line.rsplit(',').next().unwrap_or_default().trim();
+            amount
+                .parse::<u64>()
+                .unwrap_or_else(|_| panic!("金额列不是整数: {line:?}"))
+        })
+        .sum()
 }
 
